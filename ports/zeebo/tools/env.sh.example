# Caminhos dos emuladores zeebx usados pelos scripts do port.
# Os scripts leem tools/env.sh (local, nao versionado) se existir; senao este exemplo.
# Runner definido pelo Rafael: CLI zeebx-emu-copytex para automacao/gates headless.
# O AppImage (zeebx-qt 0.6.0) e so UI/playback interativo, nao tem CLI.
# Trocar de runner muda os hashes dos gates: medir, nunca esconder com hash_ref update.
ZEEBX_COPYTEX=${ZEEBX_COPYTEX:-$HOME/projects/zeebx-emu-copytex/target/release/zeebx}
ZEEBX_V060=${ZEEBX_V060:-$ZEEBX_COPYTEX}
ZEEBX_APPIMAGE=${ZEEBX_APPIMAGE:-$HOME/zeebx-release-latest/desktop-linux-x86_64-v0.6.0/zeebx-standalone-qt-linux-x86_64.AppImage}
